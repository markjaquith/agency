#!/usr/bin/env bun

import { execSync } from "child_process"

interface Commit {
	parents: string[]
	subject: string
}

// Regex to match Conventional Commits
const regex = /^(feat|fix|chore|docs|style|refactor|perf|test|ci)(\(.+\))?: .+/

function parseCommits(output: string): Commit[] {
	return output
		.trim()
		.split("\n")
		.filter(Boolean)
		.map((line) => {
			const separator = line.indexOf("\0")
			const parents = line.slice(0, separator).split(" ").filter(Boolean)
			return { parents, subject: line.slice(separator + 1) }
		})
}

try {
	// Get commits that are ahead of origin/main (or just HEAD if no remote)
	let commits: Commit[]
	try {
		const output = execSync("git log origin/main..HEAD --format=%P%x00%s", {
			encoding: "utf-8",
			stdio: ["pipe", "pipe", "pipe"],
		})
		commits = parseCommits(output)
	} catch {
		// If origin/main doesn't exist, just check the last commit
		try {
			const output = execSync("git log -1 --format=%P%x00%s", {
				encoding: "utf-8",
				stdio: ["pipe", "pipe", "pipe"],
			})
			commits = parseCommits(output)
		} catch {
			// No commits yet
			commits = []
		}
	}

	if (commits.length === 0) {
		// No commits to check
		process.exit(0)
	}

	// Check each commit
	const invalidCommits: string[] = []
	commits.forEach((commit) => {
		if (commit.parents.length < 2 && !regex.test(commit.subject)) {
			invalidCommits.push(commit.subject)
		}
	})

	if (invalidCommits.length > 0) {
		console.error("❌ Found commits that don't follow Conventional Commits:")
		console.error("——————")
		invalidCommits.forEach((msg) => {
			console.error(`  ${msg}`)
		})
		console.error("——————")
		console.error()
		console.error("Expected: <type>(<scope>): <description>")
		console.error("Example: feat(cli): add support for config files")
		process.exit(1)
	}

	process.exit(0)
} catch (error) {
	if (error instanceof Error) {
		console.error(error.message)
	}
	process.exit(1)
}
